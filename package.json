{
  "name": "@jungvonmatt/contentful-migrations",
  "version": "6.2.6",
  "description": "Helper to handle migrations in contentful",
  "main": "index.js",
  "files": [
    "index.d.ts",
    "index.js",
    "cli.js",
    "lib"
  ],
  "typings": "index.d.ts",
  "bin": {
    "contentful-migrations": "cli.js",
    "migrations": "cli.js"
  },
  "scripts": {
    "test": "vitest run --coverage && pnpm run lint",
    "lint": "eslint .  --ext .js,.ts,.tsx --ignore-path .gitignore",
    "fix-lint": "pnpm run lint -- --fix"
  },
  "packageManager": "pnpm@10.28.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jungvonmatt/contentful-migrations.git"
  },
  "author": "Ben Zörb <benjamin.zoerb@jvm.de>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "contentful",
    "migration",
    "content-type"
  ],
  "dependencies": {
    "@contentful/rich-text-plain-text-renderer": "^17.2.1",
    "@jungvonmatt/contentful-config": "^4.1.2",
    "array.prototype.flatmap": "^1.3.3",
    "ascii-tree": "^0.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^8.3.0",
    "common-tags": "^1.8.2",
    "contentful-cli": "^3.10.4",
    "contentful-import": "^9.4.140",
    "contentful-management": "^11.75.0",
    "contentful-migration": "^4.32.0",
    "deep-diff": "^1.0.2",
    "diff": "^5.2.2",
    "enquirer": "^2.4.1",
    "fs-extra": "^10.1.0",
    "globby": "^12.2.0",
    "markdown-table": "^3.0.4",
    "merge-options": "^3.0.4",
    "mustache": "^4.2.0",
    "node-fetch": "^3.3.2",
    "node-object-hash": "^2.3.10",
    "picocolors": "^1.1.1",
    "pkg-up": "^4.0.0",
    "prettier": "^2.8.8",
    "read-pkg-up": "^9.1.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "husky": "^7.0.4",
    "lint-staged": "^12.5.0",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120
  },
  "eslintConfig": {
    "ignorePatterns": [
      "**/*.d.ts"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error"
    },
    "extends": [
      "prettier"
    ],
    "parser": "@babel/eslint-parser",
    "parserOptions": {
      "requireConfigFile": false,
      "allowImportExportEverywhere": true,
      "ecmaFeatures": {
        "ecmaVersion": 2017,
        "impliedStrict": true
      }
    },
    "env": {
      "node": true
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write --ignore-path .gitignore",
      "eslint --fix --ignore-path .gitignore"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "migrations": {
    "storage": "content",
    "migrationContentTypeId": "contentful-migrations",
    "directory": "migrations"
  }
}
