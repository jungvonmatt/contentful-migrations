{
  "name": "@jungvonmatt/contentful-migrations",
  "version": "6.2.6",
  "description": "Helper to handle migrations in contentful",
  "keywords": [
    "content-type",
    "contentful",
    "migration"
  ],
  "license": "MIT",
  "author": "Ben Zörb <benjamin.zoerb@jvm.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jungvonmatt/contentful-migrations.git"
  },
  "bin": {
    "contentful-migrations": "cli.js",
    "migrations": "cli.js"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "cli.js",
    "lib"
  ],
  "main": "index.js",
  "typings": "index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --coverage && pnpm run lint",
    "lint": "oxlint",
    "fix-lint": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@contentful/rich-text-plain-text-renderer": "^17.2.1",
    "@jungvonmatt/contentful-config": "^4.1.2",
    "array.prototype.flatmap": "^1.3.3",
    "ascii-tree": "^0.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^8.3.0",
    "common-tags": "^1.8.2",
    "contentful-cli": "^3.10.4",
    "contentful-import": "^9.4.140",
    "contentful-management": "^11.75.0",
    "contentful-migration": "^4.32.0",
    "deep-diff": "^1.0.2",
    "diff": "^5.2.2",
    "enquirer": "^2.4.1",
    "fs-extra": "^10.1.0",
    "globby": "^12.2.0",
    "markdown-table": "^3.0.4",
    "merge-options": "^3.0.4",
    "mustache": "^4.2.0",
    "node-fetch": "^3.3.2",
    "node-object-hash": "^2.3.10",
    "oxfmt": "^0.50.0",
    "picocolors": "^1.1.1",
    "pkg-up": "^4.0.0",
    "read-pkg-up": "^9.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "husky": "^7.0.4",
    "lint-staged": "^12.5.0",
    "oxlint": "^1.65.0",
    "vitest": "^4.1.6"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "migrations": {
    "storage": "content",
    "migrationContentTypeId": "contentful-migrations",
    "directory": "migrations"
  }
}
